<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>화학 평형 실험실 · A ⇌ B</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a1220;
    --panel:#101b30;
    --panel-2:#0d1526;
    --border:#20304f;
    --text:#dfe8f5;
    --text-dim:#8ea0bd;
    --a-color:#4fb0ff;
    --a-glow:#4fb0ff66;
    --b-color:#ffab4f;
    --b-glow:#ffab4f66;
    --eq-color:#4fffb0;
    --eq-glow:#4fffb055;
    --grid:#1c2a45;
    --mono:'IBM Plex Mono', monospace;
    --sans:'Inter', sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse at 20% -10%, #16233d 0%, transparent 55%),
      radial-gradient(ellipse at 100% 10%, #14203a 0%, transparent 50%),
      var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.6;
    padding:32px 20px 80px;
  }
  .wrap{max-width:1080px; margin:0 auto;}

  header{margin-bottom:28px;}
  .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.18em;
    color:var(--eq-color);
    text-transform:uppercase;
    margin-bottom:10px;
  }
  h1{
    font-family:var(--mono);
    font-size:clamp(26px, 4vw, 38px);
    margin:0 0 10px;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  h1 .arrow{color:var(--text-dim); font-weight:400;}
  .lede{color:var(--text-dim); font-size:15px; max-width:640px;}

  .concept-box{
    background:linear-gradient(180deg, var(--panel-2), var(--panel));
    border:1px solid var(--border);
    border-left:3px solid var(--eq-color);
    border-radius:8px;
    padding:16px 20px;
    margin:22px 0 30px;
    font-size:14.5px;
    color:var(--text);
  }
  .concept-box b{color:var(--eq-color); font-family:var(--mono); font-weight:600;}

  .grid{
    display:grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap:18px;
    margin-bottom:18px;
  }
  @media (max-width:840px){ .grid{grid-template-columns:1fr;} }

  .panel{
    background:linear-gradient(180deg, var(--panel), var(--panel-2));
    border:1px solid var(--border);
    border-radius:12px;
    padding:20px;
  }
  .panel h2{
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--text-dim);
    margin:0 0 14px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .panel h2::before{
    content:"";
    width:6px; height:6px; border-radius:50%;
    background:var(--eq-color);
    box-shadow:0 0 8px var(--eq-glow);
  }

  /* --- flask / molecule view --- */
  #moleculeCanvas{
    width:100%;
    display:block;
    border-radius:10px;
    background:radial-gradient(circle at 50% 40%, #0f1c33 0%, #0a1424 75%);
    border:1px solid var(--border);
  }
  .legend{
    display:flex; gap:18px; margin-top:12px; font-family:var(--mono); font-size:12.5px; color:var(--text-dim);
  }
  .note-cap{
    margin-top:6px; font-size:11.5px; color:var(--text-dim); font-family:var(--mono); min-height:1.4em;
  }
  .legend span{display:flex; align-items:center; gap:6px;}
  .dot{width:10px; height:10px; border-radius:50%; display:inline-block;}
  .dot.a{background:var(--a-color); box-shadow:0 0 6px var(--a-glow);}
  .dot.b{background:var(--b-color); box-shadow:0 0 6px var(--b-glow);}

  .controls{
    margin-top:16px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px 16px;
  }
  .field{display:flex; flex-direction:column; gap:6px;}
  .field label{
    font-family:var(--mono); font-size:11.5px; color:var(--text-dim);
    display:flex; justify-content:space-between;
  }
  .field label .val{color:var(--text); font-weight:600;}
  input[type=number]{
    background:#0a1424; border:1px solid var(--border); color:var(--text);
    font-family:var(--mono); font-size:14px; padding:8px 10px; border-radius:6px;
    width:100%;
  }
  input[type=range]{width:100%; accent-color:var(--eq-color);}

  .btn-row{grid-column:1 / -1; display:flex; gap:10px; margin-top:6px;}
  button{
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:0.04em;
    padding:11px 18px;
    border-radius:7px;
    border:1px solid var(--border);
    cursor:pointer;
    background:#0d1728;
    color:var(--text);
    transition:transform .12s ease, border-color .12s ease;
  }
  button:hover:not(:disabled){transform:translateY(-1px); border-color:var(--eq-color);}
  button:disabled{opacity:0.4; cursor:not-allowed;}
  #startBtn{background:linear-gradient(180deg,#173a5e,#0e2740); border-color:#2c5a86; color:#cfe8ff; flex:1;}
  #resetBtn{flex:0 0 auto;}

  /* --- data readout --- */
  .readout-grid{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .stat{
    background:#0a1424; border:1px solid var(--border); border-radius:8px; padding:12px 14px;
  }
  .stat .label{font-family:var(--mono); font-size:11px; color:var(--text-dim); letter-spacing:.05em; text-transform:uppercase;}
  .stat .value{font-family:var(--mono); font-size:22px; font-weight:600; margin-top:4px;}
  .stat.a .value{color:var(--a-color);}
  .stat.b .value{color:var(--b-color);}
  .stat.rf .value{color:var(--a-color);}
  .stat.rr .value{color:var(--b-color);}
  .stat .unit{font-size:11px; color:var(--text-dim); font-weight:400;}

  .status{
    margin-top:14px; padding:12px 14px; border-radius:8px;
    font-family:var(--mono); font-size:13px;
    border:1px solid var(--border); background:#0a1424; color:var(--text-dim);
    transition:all .3s ease;
  }
  .time-row{
    display:flex; justify-content:space-between; margin-top:12px;
    font-family:var(--mono); font-size:12px; color:var(--text-dim);
  }

  /* --- graph panel --- */
  #rateChart{width:100%; display:block; border-radius:10px; background:#0a1424; border:1px solid var(--border);}
  .chart-legend{display:flex; gap:20px; margin-top:12px; font-family:var(--mono); font-size:12.5px; color:var(--text-dim); flex-wrap:wrap;}
  .chart-legend span{display:flex; align-items:center; gap:7px;}
  .line-sw{width:16px; height:3px; border-radius:2px; display:inline-block;}
  .line-sw.a{background:var(--a-color);}
  .line-sw.b{background:var(--b-color);}

  .explain{
    margin-top:16px; font-size:14px; color:var(--text-dim);
    border-top:1px dashed var(--border); padding-top:14px;
  }
  .explain b{color:var(--text);}
  footer{
    margin-top:26px; font-size:13px; color:var(--text-dim); text-align:center;
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="eyebrow">Chemical Equilibrium Lab</div>
    <h1>화학 평형 실험실 <span class="arrow">A ⇌ B</span></h1>
    <p class="lede">반응물 A만 넣고 반응을 시작하면 A는 B로 바뀌고(정반응), 동시에 생긴 B의 일부는 다시 A로 돌아갑니다(역반응). 두 속도가 어떻게 변하는지 직접 관찰해보세요.</p>
  </header>

  <div class="concept-box">
    <b>화학 평형이란?</b> 정반응 속도(A→B)와 역반응 속도(B→A)가 같아져서, 겉보기에는 A와 B의 양이 더 이상 변하지 않는 것처럼 보이는 상태입니다. 하지만 반응이 멈춘 것이 아니라, A→B와 B→A가 같은 속도로 계속 일어나고 있는 <b>동적 평형(dynamic equilibrium)</b> 상태입니다.
  </div>

  <div class="grid">
    <!-- LEFT: molecule flask + controls -->
    <div class="panel">
      <h2>반응 용기 (실시간 분자 관찰)</h2>
      <canvas id="moleculeCanvas" width="620" height="360"></canvas>
      <div class="legend">
        <span><i class="dot a"></i> A (반응물)</span>
        <span><i class="dot b"></i> B (생성물)</span>
      </div>
      <div class="note-cap" id="visualNote"></div>

      <div class="controls">
        <div class="field">
          <label>초기 A 개수 <span class="val" id="n0Val">100</span></label>
          <input type="number" id="n0Input" min="0" max="1000" step="1" value="100">
        </div>
        <div class="field">
          <label>정반응 속도상수 k<sub>f</sub> <span class="val" id="kfVal">0.15</span></label>
          <input type="range" id="kfInput" min="0.01" max="0.5" step="0.01" value="0.15">
        </div>
        <div class="field">
          <label>초기 B 개수 <span class="val" id="b0Val">0</span></label>
          <input type="number" id="b0Input" min="0" max="1000" step="1" value="0">
        </div>
        <div class="field">
          <label>역반응 속도상수 k<sub>r</sub> <span class="val" id="krVal">0.05</span></label>
          <input type="range" id="krInput" min="0.01" max="0.5" step="0.01" value="0.05">
        </div>

        <div class="btn-row">
          <button id="startBtn">▶ 반응 시작</button>
          <button id="resetBtn">↺ 초기화</button>
        </div>
      </div>
    </div>

    <!-- RIGHT: live data readout -->
    <div class="panel">
      <h2>실시간 측정값</h2>
      <div class="readout-grid">
        <div class="stat a">
          <div class="label">반응물 A</div>
          <div class="value"><span id="countA">100</span> <span class="unit">개</span></div>
        </div>
        <div class="stat b">
          <div class="label">생성물 B</div>
          <div class="value"><span id="countB">0</span> <span class="unit">개</span></div>
        </div>
        <div class="stat rf">
          <div class="label">정반응 속도 (k<sub>f</sub>·[A])</div>
          <div class="value"><span id="rateF">0.0</span></div>
        </div>
        <div class="stat rr">
          <div class="label">역반응 속도 (k<sub>r</sub>·[B])</div>
          <div class="value"><span id="rateR">0.0</span></div>
        </div>
      </div>

      <div class="time-row">
        <span>경과 시간(step): <b id="timeVal">0</b></span>
        <span>이론 평형상수 K<sub>c</sub>=k<sub>f</sub>/k<sub>r</sub>: <b id="kcVal">3.00</b></span>
      </div>

      <div class="status" id="statusBox">대기 중 — '반응 시작'을 눌러 실험을 시작하세요.</div>
    </div>
  </div>

  <!-- GRAPH -->
  <div class="panel">
    <h2>시간에 따른 정반응·역반응 속도 그래프</h2>
    <canvas id="rateChart" width="1000" height="300"></canvas>
    <div class="chart-legend">
      <span><i class="line-sw a"></i> 정반응 속도 (A→B)</span>
      <span><i class="line-sw b"></i> 역반응 속도 (B→A)</span>
    </div>
    <div class="explain">
      <div id="explainText">그래프를 보면, 반응 초기에는 A가 많아 <b>정반응 속도가 크고</b>, B가 없어 <b>역반응 속도는 0</b>입니다. 시간이 지나면서 A는 줄고 B는 늘어나므로 정반응 속도는 점점 감소하고 역반응 속도는 점점 증가합니다. 두 곡선이 <b>가까워지고 겹쳐지는 구간</b>이 화학 평형 상태이며, 이후에는 A, B의 양이 거시적으로 더 이상 변하지 않습니다. (다만 반응이 멈춘 것은 아니며, 두 속도가 같아진 채로 계속 진행됩니다.)</div>
    </div>
  </div>

  <footer>정반응 속도 = k<sub>f</sub> × [A], 역반응 속도 = k<sub>r</sub> × [B] · 평형 조건: k<sub>f</sub>[A]<sub>eq</sub> = k<sub>r</sub>[B]<sub>eq</sub></footer>
</div>

<script>
(function(){
  "use strict";

  // ---------- DOM ----------
  const n0Input = document.getElementById('n0Input');
  const b0Input = document.getElementById('b0Input');
  const kfInput = document.getElementById('kfInput');
  const krInput = document.getElementById('krInput');
  const n0Val = document.getElementById('n0Val');
  const b0Val = document.getElementById('b0Val');
  const kfVal = document.getElementById('kfVal');
  const krVal = document.getElementById('krVal');
  const kcVal = document.getElementById('kcVal');
  const startBtn = document.getElementById('startBtn');
  const resetBtn = document.getElementById('resetBtn');
  const countAEl = document.getElementById('countA');
  const countBEl = document.getElementById('countB');
  const rateFEl = document.getElementById('rateF');
  const rateREl = document.getElementById('rateR');
  const timeValEl = document.getElementById('timeVal');
  const statusBox = document.getElementById('statusBox');

  const molCanvas = document.getElementById('moleculeCanvas');
  const molCtx = molCanvas.getContext('2d');
  const chartCanvas = document.getElementById('rateChart');
  const chartCtx = chartCanvas.getContext('2d');

  // ---------- state ----------
  let A = 100, B = 0;
  let kf = 0.15, kr = 0.05;
  let particles = [];
  let time = 0;
  let running = false;
  let history = []; // {t, rateF, rateR}
  let simTimer = null;
  let animFrame = null;

  function updateLabels(){
    n0Val.textContent = n0Input.value;
    b0Val.textContent = b0Input.value;
    kfVal.textContent = parseFloat(kfInput.value).toFixed(2);
    krVal.textContent = parseFloat(krInput.value).toFixed(2);
    kcVal.textContent = (parseFloat(kfInput.value) / parseFloat(krInput.value)).toFixed(2);
    updateExplanation(parseInt(n0Input.value,10)||0, parseInt(b0Input.value,10)||0);
  }
  [n0Input, b0Input, kfInput, krInput].forEach(el => el.addEventListener('input', updateLabels));

  // 초기 조건(A만 있음 / B만 있음 / 둘 다 있음)에 따라 설명 문구를 다르게 보여준다.
  const explainEl = document.getElementById('explainText');
  function updateExplanation(A0, B0){
    if(!explainEl) return;
    if(A0 > 0 && B0 <= 0){
      explainEl.innerHTML = '그래프를 보면, 반응 초기에는 A만 있어 <b>정반응 속도가 최대</b>이고 B가 없어 <b>역반응 속도는 0</b>입니다. 시간이 지나면서 A는 줄고 B는 늘어나므로 정반응 속도는 점점 감소하고 역반응 속도는 점점 증가합니다. 두 곡선이 <b>가까워지고 겹쳐지는 구간</b>이 화학 평형 상태이며, 이후에는 A, B의 양이 거시적으로 더 이상 변하지 않습니다. (다만 반응이 멈춘 것은 아니며, 두 속도가 같아진 채로 계속 진행됩니다.)';
    } else if(B0 > 0 && A0 <= 0){
      explainEl.innerHTML = '그래프를 보면, 반응 초기에는 B만 있어 <b>역반응 속도가 최대</b>이고 A가 없어 <b>정반응 속도는 0</b>입니다. 시간이 지나면서 B는 줄어 A로 전환되고 A는 늘어나므로, 역반응 속도는 점점 감소하고 정반응 속도는 점점 증가합니다. 두 곡선이 <b>가까워지고 겹쳐지는 구간</b>이 화학 평형 상태이며, 이후에는 A, B의 양이 거시적으로 더 이상 변하지 않습니다. (다만 반응이 멈춘 것은 아니며, 두 속도가 같아진 채로 계속 진행됩니다.)';
    } else if(A0 > 0 && B0 > 0){
      explainEl.innerHTML = '그래프를 보면, 반응 초기부터 A와 B가 함께 존재하므로 <b>정반응 속도와 역반응 속도가 모두 0이 아닌 값</b>에서 시작합니다. 두 속도 중 더 큰 쪽이 이끄는 방향으로 A와 B의 양이 서서히 변하고, 시간이 지남에 따라 두 속도는 서로 <b>가까워지다가 결국 같아지는 방향</b>으로 평형에 도달합니다. 평형에 도달한 뒤에는 A, B의 양이 거시적으로 더 이상 변하지 않습니다. (다만 반응이 멈춘 것은 아니며, 두 속도가 같아진 채로 계속 진행됩니다.)';
    } else {
      explainEl.innerHTML = 'A와 B의 초기 개수를 입력하고 반응을 시작하면, 정반응·역반응 속도가 시간에 따라 어떻게 변하며 평형에 도달하는지 그래프로 확인할 수 있습니다.';
    }
  }
  updateLabels();

  // ---------- particle setup (molecule view) ----------
  // 실제 개수(A,B)는 최대 2000까지 가능하지만, 화면에는 최대 VISUAL_CAP개의
  // "대표 입자"만 그려서 비율(A:B)을 시각적으로 보여준다. 실제 반응 속도/개수 계산은
  // 항상 진짜 A, B 값을 사용하므로 화면 표시 개수와 무관하게 정확하다.
  const VISUAL_CAP = 260;

  function initParticles(){
    particles = [];
    const cx = molCanvas.width/2, cy = molCanvas.height/2;
    const R = Math.min(molCanvas.width, molCanvas.height)/2 - 20;
    const totalReal = A + B;
    const visualTotal = Math.min(totalReal, VISUAL_CAP);
    let visualA = totalReal > 0 ? Math.round(visualTotal * (A/totalReal)) : 0;
    visualA = Math.max(0, Math.min(visualTotal, visualA));
    for(let i=0;i<visualTotal;i++){
      const ang = Math.random()*Math.PI*2;
      const rad = Math.sqrt(Math.random())*R;
      particles.push({
        x: cx + Math.cos(ang)*rad,
        y: cy + Math.sin(ang)*rad,
        vx: (Math.random()-0.5)*1.6,
        vy: (Math.random()-0.5)*1.6,
        type: i < visualA ? 'A' : 'B'
      });
    }
    const noteEl = document.getElementById('visualNote');
    if(noteEl){
      noteEl.textContent = totalReal > VISUAL_CAP
        ? `※ 실제 개수는 A=${A}, B=${B}이지만, 화면에는 비율을 보여주는 대표 입자 ${visualTotal}개만 표시됩니다.`
        : '';
    }
  }

  // 실제 A,B 비율에 맞춰 화면에 그려진 대표 입자들의 색(A/B)만 갱신한다 (개수·위치는 유지).
  function syncVisualParticles(){
    const totalReal = A + B;
    if(particles.length === 0 || totalReal <= 0) return;
    const visualTotal = particles.length;
    let targetA = Math.round(visualTotal * (A/totalReal));
    targetA = Math.max(0, Math.min(visualTotal, targetA));
    let currentA = 0;
    for(const p of particles){ if(p.type==='A') currentA++; }
    if(currentA < targetA){
      let need = targetA - currentA;
      for(const p of particles){
        if(need<=0) break;
        if(p.type==='B'){ p.type='A'; need--; }
      }
    } else if(currentA > targetA){
      let need = currentA - targetA;
      for(const p of particles){
        if(need<=0) break;
        if(p.type==='A'){ p.type='B'; need--; }
      }
    }
  }

  function drawFlask(){
    molCtx.clearRect(0,0,molCanvas.width, molCanvas.height);
    const cx = molCanvas.width/2, cy = molCanvas.height/2;
    const R = Math.min(molCanvas.width, molCanvas.height)/2 - 20;

    // container ring
    molCtx.beginPath();
    molCtx.arc(cx, cy, R, 0, Math.PI*2);
    molCtx.strokeStyle = '#20304f';
    molCtx.lineWidth = 2;
    molCtx.stroke();

    // particles
    particles.forEach(p=>{
      molCtx.beginPath();
      molCtx.arc(p.x, p.y, 5, 0, Math.PI*2);
      if(p.type==='A'){
        molCtx.fillStyle = '#4fb0ff';
        molCtx.shadowColor = '#4fb0ff';
      } else {
        molCtx.fillStyle = '#ffab4f';
        molCtx.shadowColor = '#ffab4f';
      }
      molCtx.shadowBlur = 6;
      molCtx.fill();
    });
    molCtx.shadowBlur = 0;
  }

  function moveParticles(){
    const cx = molCanvas.width/2, cy = molCanvas.height/2;
    const R = Math.min(molCanvas.width, molCanvas.height)/2 - 22;
    particles.forEach(p=>{
      p.x += p.vx;
      p.y += p.vy;
      const dx = p.x - cx, dy = p.y - cy;
      const dist = Math.sqrt(dx*dx+dy*dy);
      if(dist > R){
        // reflect off circular boundary
        const nx = dx/dist, ny = dy/dist;
        const dot = p.vx*nx + p.vy*ny;
        p.vx -= 2*dot*nx;
        p.vy -= 2*dot*ny;
        p.x = cx + nx*R;
        p.y = cy + ny*R;
      }
    });
  }

  function renderLoop(){
    if(running){ moveParticles(); }
    drawFlask();
    animFrame = requestAnimationFrame(renderLoop);
  }

  // ---------- chart ----------
  function drawChart(){
    const w = chartCanvas.width, h = chartCanvas.height;
    chartCtx.clearRect(0,0,w,h);
    const padL = 46, padR = 20, padT = 16, padB = 30;
    const plotW = w - padL - padR, plotH = h - padT - padB;

    // grid
    chartCtx.strokeStyle = '#1c2a45';
    chartCtx.lineWidth = 1;
    chartCtx.font = '11px IBM Plex Mono, monospace';
    chartCtx.fillStyle = '#8ea0bd';
    const maxRate = Math.max(1, kf * (parseFloat(n0Input.value)||100) + (parseFloat(b0Input.value)||0)*kr, ...history.map(pt=>Math.max(pt.rateF,pt.rateR))) * 1.15;
    const maxT = Math.max(20, time);

    for(let i=0;i<=4;i++){
      const y = padT + plotH - (i/4)*plotH;
      chartCtx.beginPath();
      chartCtx.moveTo(padL, y);
      chartCtx.lineTo(w-padR, y);
      chartCtx.stroke();
      chartCtx.fillText((maxRate*i/4).toFixed(1), 6, y+4);
    }
    chartCtx.fillText('속도', 4, padT-4);
    chartCtx.fillText('시간(step) →', w-padR-70, h-8);

    function xPos(t){ return padL + (t/maxT)*plotW; }
    function yPos(v){ return padT + plotH - (v/maxRate)*plotH; }

    function drawLine(key, color){
      if(history.length < 2) return;
      chartCtx.beginPath();
      chartCtx.strokeStyle = color;
      chartCtx.lineWidth = 2.4;
      history.forEach((pt, idx)=>{
        const x = xPos(pt.t), y = yPos(pt[key]);
        if(idx===0) chartCtx.moveTo(x,y); else chartCtx.lineTo(x,y);
      });
      chartCtx.stroke();
    }
    drawLine('rateF', '#4fb0ff');
    drawLine('rateR', '#ffab4f');
  }

  // ---------- simulation tick ----------
  function tick(){
    time += 1;
    kf = parseFloat(kfInput.value);
    kr = parseFloat(krInput.value);

    const rF = kf * A;
    const rR = kr * B;
    history.push({t: time, rateF: rF, rateR: rR});
    if(history.length > 4000) history.shift();

    // 실제 A, B(최대 1000개씩, 총 최대 2000개)에 대해 반응 속도 법칙(rate = k × 개수)에 따라
    // 확률적 반올림(stochastic rounding)으로 이번 스텝에 전환되는 개수를 계산한다.
    // 화면에 그려지는 대표 입자 수와 무관하게 항상 실제 개수를 기준으로 정확히 계산된다.
    const expF = kf * A;
    const expR = kr * B;
    let convF = Math.floor(expF) + (Math.random() < (expF - Math.floor(expF)) ? 1 : 0);
    let convR = Math.floor(expR) + (Math.random() < (expR - Math.floor(expR)) ? 1 : 0);
    convF = Math.min(convF, A);
    convR = Math.min(convR, B);
    A = A - convF + convR;
    B = B + convF - convR;

    syncVisualParticles();

    countAEl.textContent = A;
    countBEl.textContent = B;
    rateFEl.textContent = rF.toFixed(2);
    rateREl.textContent = rR.toFixed(2);
    timeValEl.textContent = time;
    statusBox.textContent = `반응 진행 중 · 정반응 속도 ${rF.toFixed(2)} / 역반응 속도 ${rR.toFixed(2)}`;
    drawChart();
  }

  // ---------- controls ----------
  function resetAll(stopOnly){
    running = false;
    clearInterval(simTimer);
    startBtn.disabled = false;
    n0Input.disabled = false;
    b0Input.disabled = false;
    startBtn.textContent = '▶ 반응 시작';

    if(!stopOnly){
      A = parseInt(n0Input.value) || 100;
      B = parseInt(b0Input.value) || 0;
      time = 0;
      history = [];
      statusBox.textContent = "대기 중 — '반응 시작'을 눌러 실험을 시작하세요.";
      countAEl.textContent = A;
      countBEl.textContent = B;
      rateFEl.textContent = '0.0';
      rateREl.textContent = '0.0';
      timeValEl.textContent = 0;
      initParticles();
      drawChart();
    }
  }

  const MAX_TOTAL = 2000;

  startBtn.addEventListener('click', ()=>{
    if(running) return;
    A = parseInt(n0Input.value, 10);
    B = parseInt(b0Input.value, 10);
    if(!Number.isFinite(A) || A < 0) A = 0;
    if(!Number.isFinite(B) || B < 0) B = 0;

    let note = '';
    if(A + B < 1){
      A = 100; B = 0;
      note = ' (입력값이 없어 기본값 A=100으로 시작합니다)';
    } else if(A + B > MAX_TOTAL){
      const scale = MAX_TOTAL / (A + B);
      A = Math.max(1, Math.round(A * scale));
      B = Math.max(0, MAX_TOTAL - A);
      note = ` (총 개수가 많아 ${MAX_TOTAL}개로 자동 조정됨: A=${A}, B=${B})`;
    }
    n0Input.value = A;
    b0Input.value = B;
    updateLabels();

    time = 0;
    history = [];
    initParticles();
    running = true;
    startBtn.disabled = true;
    n0Input.disabled = true;
    b0Input.disabled = true;
    startBtn.textContent = '반응 진행 중…';
    statusBox.textContent = `반응 시작${note}`;
    simTimer = setInterval(tick, 180);
  });

  resetBtn.addEventListener('click', ()=> resetAll(false));

  // ---------- init ----------
  resetAll(false);
  renderLoop();
})();
</script>
</body>
</html>
